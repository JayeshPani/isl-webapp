# Backend server
HOST=127.0.0.1
PORT=8000

# Model
MODEL_PATH=backend/models/best.pt
MODEL_MODE=detect

# Realtime frame pipeline
FRAME_SIZE=416
SEND_FPS=15

# Smoothing and commit logic
MIN_CONFIDENCE=0.45
MIN_MARGIN=0.10
SMOOTHING_WINDOW=8
MIN_VOTES=4
COMMIT_COOLDOWN_MS=700
DUPLICATE_BLOCK_UNTIL_CHANGED=true
DUPLICATE_BLOCK_MS=1400
DUPLICATE_RESET_UNKNOWN_FRAMES=3

# Labels
UNKNOWN_LABEL=unknown
SPACE_LABEL=space
DELETE_LABEL=delete

# Hand ROI preprocessing (optional, uses MediaPipe Hands if installed)
ENABLE_HAND_ROI=false
HAND_ROI_ONLY_FOR_DIRECT_CLS=true
HAND_ROI_MASK_BACKGROUND=true
HAND_ROI_EXPAND_RATIO=0.35
HAND_ROI_SMOOTHING=0.55
HAND_ROI_MIN_AREA_RATIO=0.03
HAND_ROI_REUSE_LAST_BBOX_FRAMES=4
HAND_ROI_MAX_NUM_HANDS=1
HAND_ROI_MIN_DETECTION_CONFIDENCE=0.50
HAND_ROI_MIN_TRACKING_CONFIDENCE=0.50

# Prediction output
ENABLE_TOPK=true
TOPK=3
DEBUG=true
DIRECT_CLS_ENABLE_TTA=true
DIRECT_CLS_INCLUDE_FLIP=true
DIRECT_CLS_INCLUDE_ZOOM=true
DIRECT_CLS_ZOOM_RATIO=0.78
DIRECT_CLS_MIN_VIEW_VOTES=2

# Future hook
ENABLE_SEQUENCE_HOOK=false

# Optional fallback class list when model names are not available
MOCK_CLASS_NAMES=A,B,C,D,E,HELLO,THANK_YOU,space,delete,unknown
